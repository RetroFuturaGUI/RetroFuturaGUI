#pragma once
#include <cstdint>
#include <cstdlib>
#include <string_view>
#include <concepts>

using i8 = int8_t;
using u8 = uint8_t;
using i16 = int16_t;
using u16 = uint16_t;
using i32 = int32_t;
using u32 = uint32_t;
using i64 = int64_t;
using u64 = uint64_t;
using f32 = float;
using f64 = double;
using uSize = size_t;
using uChar = unsigned char;

namespace RetroFuturaGUI
{
    static constexpr bool isInvalidCodepoint(const char32_t codepoint)
    {
        return 0x20 > codepoint
            || (0x7F <= codepoint && 0x9F >= codepoint)
            || (0xD800 <= codepoint && 0xDFFF >= codepoint)
            || 0x10FFFF < codepoint;
    }

    template<typename T>
    concept NumericValueType =
        std::same_as<T, bool> ||
        std::same_as<T, i8>  || std::same_as<T, i16> || std::same_as<T, i32> || std::same_as<T, i64> ||
        std::same_as<T, u8>  || std::same_as<T, u16> || std::same_as<T, u32> || std::same_as<T, u64> ||
        std::same_as<T, f32> || std::same_as<T, f64>;

    enum class PrimitiveTypeID : u32
    {
        Bool,
        Int8,
        Int16,
        Int32,
        Int64,
        UInt8,
        UInt16,
        UInt32,
        UInt64,
        Float32,
        Float64
    };

    union PrimitiveUnion
    {
        bool Bool;
        i8 Int8;
        i16 Int16;
        i32 Int32;
        i64 Int64;
        u8 UInt8;
        u16 UInt16;
        u32 UInt32;
        u64 UInt64;
        f32 Float32;
        f64 Float64;
    };

    /// @brief FNV-1a hash of a name
    constexpr u32 Fnv1aHash(std::string_view str)
    {
        u32 hash = 2166136261;

        for(uChar ch : str)
        {
            hash ^= ch;
            hash *= 16777619;
        }

        return hash;
    }

    template<NumericValueType T>
    constexpr PrimitiveTypeID GetPrimitiveTypeID()
    {
        if constexpr (std::same_as<T, bool>)
            return PrimitiveTypeID::Bool;
        else if constexpr (std::same_as<T, i8>)
            return PrimitiveTypeID::Int8;
        else if constexpr (std::same_as<T, i16>)
            return PrimitiveTypeID::Int16;
        else if constexpr (std::same_as<T, i32>)
            return PrimitiveTypeID::Int32;
        else if constexpr (std::same_as<T, i64>)
            return PrimitiveTypeID::Int64;
        else if constexpr (std::same_as<T, u8>)
            return PrimitiveTypeID::UInt8;
        else if constexpr (std::same_as<T, u16>)
            return PrimitiveTypeID::UInt16;
        else if constexpr (std::same_as<T, u32>)
            return PrimitiveTypeID::UInt32;
        else if constexpr (std::same_as<T, u64>)
            return PrimitiveTypeID::UInt64;
        else if constexpr (std::same_as<T, f32>)
            return PrimitiveTypeID::Float32;
        else if constexpr (std::same_as<T, f64>)
            return PrimitiveTypeID::Float64;
    }
}

#ifdef DYNLIB_MODE
    #ifdef _WIN32
        #define EXPORT_API __declspec(dllexport)
    #else
        #define EXPORT_API __attribute__((visibility("default")))
    #endif
#endif
